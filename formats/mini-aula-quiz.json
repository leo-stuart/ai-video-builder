{
  "id": "mini-aula-quiz",
  "title": "Mini-aula com quiz",
  "desc": "Uma pergunta, três opções em contagem regressiva, a resposta certa, e treino com o tutor. 10 cenas, cerca de 35 s.",
  "slots": [
    {
      "key": "question",
      "ask": "A pergunta de quem atende, em inglês.",
      "example": "Window or aisle?"
    },
    {
      "key": "quizAsk",
      "ask": "A pergunta do quiz, em narração, com *ênfase*.",
      "example": "Qual resposta é a *certa*?"
    },
    {
      "key": "optA",
      "ask": "Opção A, em inglês (até 28 caracteres).",
      "example": "Corridor, please."
    },
    {
      "key": "optB",
      "ask": "Opção B, em inglês (até 28 caracteres).",
      "example": "Aisle, please."
    },
    {
      "key": "optC",
      "ask": "Opção C, em inglês (até 28 caracteres).",
      "example": "Hallway, please."
    },
    {
      "key": "correct",
      "ask": "A letra certa: A, B ou C.",
      "example": "B"
    },
    {
      "key": "answerNarr",
      "ask": "A resposta em narração, com a letra em *ênfase*.",
      "example": "É a letra *B*."
    },
    {
      "key": "right",
      "ask": "O texto da opção certa.",
      "example": "Aisle, please."
    },
    {
      "key": "rightPt",
      "ask": "A resposta certa em português.",
      "example": "corredor, por favor"
    }
  ],
  "post": {
    "caption": "Quiz rápido: \"{{question}}\" — qual resposta é a certa?\n\nResposta: \"{{right}}\" ({{rightPt}}).\n\nQual frase já te congelou lá fora? Conta aqui 👇",
    "shortsTitle": "Quiz: como responder \"{{question}}\""
  },
  "beats": [
    {
      "id": "abertura",
      "type": "title-card",
      "narration": "{{pool:quiz}}",
      "params": {
        "card": "Quiz rápido"
      }
    },
    {
      "id": "pergunta",
      "type": "ask",
      "speaker": "atendente",
      "narration": "[en]{{question}}[/en]"
    },
    {
      "id": "quiz",
      "type": "quiz-question",
      "narration": "{{quizAsk}}",
      "hold": 1.5,
      "params": {
        "optA": "{{optA}}",
        "optB": "{{optB}}",
        "optC": "{{optC}}"
      }
    },
    {
      "id": "gabarito",
      "type": "quiz-answer",
      "narration": "{{answerNarr}}",
      "hold": 0.6,
      "params": {
        "optA": "{{optA}}",
        "optB": "{{optB}}",
        "optC": "{{optC}}",
        "correct": "{{correct}}"
      }
    },
    {
      "id": "pragma",
      "type": "app-enter",
      "narration": "{{pool:abre}}"
    },
    {
      "id": "treino",
      "type": "tutor-line",
      "speaker": "tutor",
      "sub": "Diga: \"{{rightPt}}\".",
      "narration": "[en]Say: {{right}}[/en]",
      "params": {
        "plate": "{{right}}"
      }
    },
    {
      "id": "certo",
      "type": "user-success",
      "speaker": "voce",
      "narration": "[en]{{right}}[/en]",
      "hold": 0.6
    },
    {
      "id": "habito",
      "type": "pitch-habit",
      "narration": "{{pool:habito}}"
    },
    {
      "id": "fim",
      "type": "end-card",
      "narration": "{{pool:fim}}",
      "captions": false,
      "hold": 1.6
    }
  ],
  "target": [
    25,
    40
  ]
}
