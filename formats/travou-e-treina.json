{
  "id": "travou-e-treina",
  "title": "Travou e treina",
  "desc": "\"Você\" trava numa pergunta em inglês lá fora, treina com o tutor de IA do Pragma e volta para acertar. 19 cenas, cerca de 45 s.",
  "slots": [
    {
      "key": "hook",
      "ask": "Gancho: o quanto você já estudou, com *ênfase* no número. Até 10 palavras.",
      "example": "Você fez *seis anos* de curso de inglês."
    },
    {
      "key": "hookPlate",
      "ask": "O número do gancho, para o cartão da tela.",
      "example": "6 anos"
    },
    {
      "key": "hookPin",
      "ask": "Rótulo curto do gancho (até 16 caracteres).",
      "example": "Diploma"
    },
    {
      "key": "arrive",
      "ask": "Chegada ao lugar. Precisa de uma vírgula antes da necessidade.",
      "example": "Aí chega em *Nova York*, morrendo de fome."
    },
    {
      "key": "city",
      "ask": "A cidade ou lugar, para o rótulo.",
      "example": "Nova York"
    },
    {
      "key": "need",
      "ask": "O som da necessidade (até 16 caracteres).",
      "example": "Ronc…"
    },
    {
      "key": "pose",
      "ask": "hungry, tired, late ou cold.",
      "example": "hungry",
      "default": "hungry"
    },
    {
      "key": "question",
      "ask": "A pergunta em inglês que dá o branco.",
      "example": "Hi! For here or to go?"
    },
    {
      "key": "questionPt",
      "ask": "A pergunta em português falado.",
      "example": "Pra comer aqui ou pra levar?"
    },
    {
      "key": "wrong",
      "ask": "A resposta errada que brasileiro dá.",
      "example": "I want to go."
    },
    {
      "key": "wrongMeaning",
      "ask": "O que o erro quis dizer, em português, com graça.",
      "example": "quero ir embora"
    },
    {
      "key": "right",
      "ask": "A resposta certa, curta.",
      "example": "To go, please."
    },
    {
      "key": "rightPt",
      "ask": "A resposta certa em português.",
      "example": "pra levar, por favor"
    },
    {
      "key": "loss",
      "ask": "O prejuízo, em narração, terminando com *sem <coisa>*.",
      "example": "E você sai de lá *sem café*."
    },
    {
      "key": "lossCard",
      "ask": "O prejuízo com número, para o cartão.",
      "example": "0 cafés"
    },
    {
      "key": "heavy",
      "ask": "Rótulo do prato pesado da metáfora (até 16 caracteres).",
      "example": "Provas: nota 10"
    },
    {
      "key": "light",
      "ask": "Rótulo do prato leve (até 16 caracteres).",
      "example": "Falar: quase 0",
      "default": "Falar: quase 0"
    }
  ],
  "beats": [
    {
      "id": "curso",
      "type": "hook-walk-out",
      "narration": "{{hook}}",
      "params": {
        "plate": "{{hookPlate}}",
        "pin": "{{hookPin}}"
      }
    },
    {
      "id": "ny",
      "type": "arrive-need",
      "narration": "{{arrive}}",
      "params": {
        "city": "{{city}}",
        "need": "{{need}}",
        "pose": "{{pose}}"
      }
    },
    {
      "id": "pergunta",
      "type": "ask",
      "speaker": "atendente",
      "narration": "[en]{{question}}[/en]"
    },
    {
      "id": "trava",
      "type": "freeze",
      "narration": "{{pool:trava}}",
      "hold": 0.4
    },
    {
      "id": "yes",
      "type": "line-me",
      "speaker": "voce",
      "narration": "[en]Uh… yes?[/en]",
      "hold": 0.3
    },
    {
      "id": "what",
      "type": "line-other",
      "speaker": "atendente",
      "narration": "[en]Yes… what?[/en]",
      "hold": 0.2
    },
    {
      "id": "fila",
      "type": "crowd",
      "narration": "{{pool:fila}}"
    },
    {
      "id": "fora",
      "type": "walk-out-street",
      "narration": "{{loss}}",
      "params": {
        "loss": "{{lossCard}}"
      }
    },
    {
      "id": "balanca",
      "type": "metaphor",
      "narration": "{{pool:causa}}",
      "params": {
        "heavy": "{{heavy}}",
        "light": "{{light}}"
      }
    },
    {
      "id": "pragma",
      "type": "app-enter",
      "narration": "{{pool:abre}}"
    },
    {
      "id": "treino",
      "type": "tutor-line",
      "speaker": "tutor",
      "sub": "{{questionPt}}",
      "narration": "[en]{{questionShort}}[/en]"
    },
    {
      "id": "erro",
      "type": "user-error",
      "speaker": "voce",
      "narration": "[en]{{wrong}}[/en]",
      "params": {
        "meaning": "{{wrongMeaning}}"
      },
      "hold": 0.5
    },
    {
      "id": "corrige",
      "type": "tutor-line",
      "speaker": "tutor",
      "sub": "Quase! Diga: \"{{rightPt}}\".",
      "narration": "[en]Almost! Say: {{rightSay}}[/en]",
      "params": {
        "plate": "{{right}}"
      }
    },
    {
      "id": "certo",
      "type": "user-success",
      "speaker": "voce",
      "narration": "[en]{{right}}[/en]",
      "hold": 0.6
    },
    {
      "id": "habito",
      "type": "pitch-habit",
      "narration": "{{pool:habito}}"
    },
    {
      "id": "volta",
      "type": "walk-street",
      "narration": "{{pool:volta}}"
    },
    {
      "id": "revanche",
      "type": "ask",
      "speaker": "atendente",
      "narration": "[en]{{questionShort}}[/en]",
      "params": {
        "close": true,
        "meMood": "happy"
      }
    },
    {
      "id": "resposta",
      "type": "win",
      "speaker": "voce",
      "narration": "[en]{{rightBang}}[/en]",
      "hold": 1.0
    },
    {
      "id": "fim",
      "type": "end-card",
      "narration": "{{pool:fim}}",
      "captions": false,
      "hold": 1.6
    }
  ],
  "post": {
    "caption": "{{hookPlain}} Aí perguntam \"{{questionShort}}\" e você trava.\n\nÉ só \"{{questionPt}}\". Resposta: \"{{right}}\"\n\nQual frase já te congelou lá fora? Conta aqui 👇",
    "shortsTitle": "\"{{questionShort}}\": como responder em inglês"
  },
  "target": [
    38,
    50
  ]
}
