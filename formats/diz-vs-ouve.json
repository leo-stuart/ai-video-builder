{
  "id": "diz-vs-ouve",
  "title": "O que você diz vs o que ele ouve",
  "desc": "\"Você\" diz uma frase que parece certa, mas quem atende ouve outra coisa. Corrige com o tutor e acerta. 12 cenas, cerca de 35 s.",
  "slots": [
    {
      "key": "wrong",
      "ask": "A frase errada que brasileiro diz, em inglês.",
      "example": "I have 25 years."
    },
    {
      "key": "wrongMeaning",
      "ask": "O que quem atende ouviu, em português, com graça (até 40 caracteres).",
      "example": "Eu tenho 25 anos de idade… de quê?"
    },
    {
      "key": "heardPt",
      "ask": "O que ele ouviu, em narração, com *ênfase*.",
      "example": "Só que ele ouviu: *tenho 25 anos de quê?*"
    },
    {
      "key": "reaction",
      "ask": "A reação de quem atende, em inglês.",
      "example": "Sorry, what?",
      "default": "Sorry, what?"
    },
    {
      "key": "right",
      "ask": "A frase certa, curta.",
      "example": "I'm 25."
    },
    {
      "key": "rightPt",
      "ask": "A frase certa em português.",
      "example": "eu tenho 25 anos"
    },
    {
      "key": "rightCompare",
      "ask": "O certo, em texto, para a tela (até 30 caracteres).",
      "example": "I'm 25. (ser, não ter)"
    },
    {
      "key": "wrongCompare",
      "ask": "O errado, em texto, para a tela (até 30 caracteres).",
      "example": "I have 25 years."
    }
  ],
  "post": {
    "caption": "Você diz \"{{wrong}}\" e ele ouve outra coisa.\n\nResposta: \"{{right}}\" ({{rightPt}}).\n\nQual frase já te congelou lá fora? Conta aqui 👇",
    "shortsTitle": "\"{{wrong}}\": o erro que todo brasileiro comete"
  },
  "beats": [
    {
      "id": "abertura",
      "type": "title-card",
      "narration": "{{pool:dizouve}}",
      "params": {
        "card": "Você diz × Ele ouve"
      }
    },
    {
      "id": "diz",
      "type": "say-me",
      "speaker": "voce",
      "narration": "[en]{{wrong}}[/en]",
      "hold": 0.4
    },
    {
      "id": "ouviu",
      "type": "heard",
      "narration": "{{heardPt}}",
      "params": {
        "meaning": "{{wrongMeaning}}"
      }
    },
    {
      "id": "reacao",
      "type": "line-other",
      "speaker": "atendente",
      "narration": "[en]{{reaction}}[/en]",
      "params": {
        "ice": 0,
        "mood": "angry"
      },
      "hold": 0.3
    },
    {
      "id": "regra",
      "type": "compare",
      "narration": "O certo é: [en]{{right}}[/en]",
      "params": {
        "wrong": "{{wrongCompare}}",
        "right": "{{rightCompare}}"
      }
    },
    {
      "id": "pragma",
      "type": "app-enter",
      "narration": "{{pool:abre}}"
    },
    {
      "id": "treino",
      "type": "tutor-line",
      "speaker": "tutor",
      "sub": "Diga: \"{{rightPt}}\".",
      "narration": "[en]Say: {{right}}[/en]",
      "params": {
        "plate": "{{right}}"
      }
    },
    {
      "id": "certo",
      "type": "user-success",
      "speaker": "voce",
      "narration": "[en]{{right}}[/en]",
      "hold": 0.6
    },
    {
      "id": "volta",
      "type": "walk-street",
      "narration": "{{pool:volta}}"
    },
    {
      "id": "resposta",
      "type": "win",
      "speaker": "voce",
