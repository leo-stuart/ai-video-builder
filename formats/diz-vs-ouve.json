      "hold": 1.0
    },
    {
      "id": "habito",
      "type": "pitch-habit",
      "narration": "{{pool:habito}}"
    },
    {
      "id": "fim",
      "type": "end-card",
      "narration": "{{pool:fim}}",
      "captions": false,
      "hold": 1.6
    }
